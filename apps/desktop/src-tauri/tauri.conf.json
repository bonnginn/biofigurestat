{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Life Science Analysis",
  "version": "0.1.0",
  "identifier": "jp.ac.mie.lifescience.analysis",
  "build": {
    "beforeDevCommand": "pnpm --filter @lsaa/ui dev --host 127.0.0.1",
    "beforeBuildCommand": "pnpm --filter @lsaa/ui build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Life Science Analysis",
        "width": 1280,
        "height": 900,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "fileAssociations": [
      {
        "ext": ["lsa"],
        "name": "Life Science Analysis Project",
        "description": "Life Science Analysis project package",
        "role": "Editor",
        "rank": "Owner",
        "mimeType": "application/x-lifescience-analysis-project",
        "exportedType": {
          "identifier": "jp.ac.mie.lifescience.analysis.project",
          "conformsTo": ["public.data"]
        }
      }
    ]
  }
}
