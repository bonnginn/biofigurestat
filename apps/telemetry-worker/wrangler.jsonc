{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "biofigurestat-telemetry",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-30",
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "biofigurestat-telemetry",
      "database_id": "86cfbb8c-77e6-4944-8f8b-51ce67b71a6e",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    "ALLOWED_ORIGINS": "tauri://localhost,http://tauri.localhost,https://tauri.localhost",
    "RETENTION_DAYS": "90",
  },
  "ratelimits": [
    {
      "name": "REPORT_RATE_LIMITER",
      "namespace_id": "2026083001",
      "simple": { "limit": 5, "period": 60 },
    },
  ],
  "triggers": {
    "crons": ["17 3 * * *"],
  },
}
